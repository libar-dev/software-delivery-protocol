# Local planning artifacts — kept on disk for working notes, out of the published repo
# plans/

# User's scratchpad
.tmp-scratch/

# User-local editor state — keep the shared Gherkin association for *.sdp.gherkin
.vscode/*
!.vscode/settings.json

# macOS Finder metadata
.DS_Store

# Tooling outputs
node_modules/
dist/
generated/
# Runnable registrars are regenerable siblings. Adopted modules are force-added and reviewed;
# unadopted family output remains disposable until its authored test imports it.
**/*.test.generated.ts
.sisyphus/evidence/

# OmO runtime state is ignored; durable plans and recovery evidence are tracked below
.sisyphus/
.omo/*
!.omo/boulder.json
!.omo/drafts/
!.omo/plans/
!.omo/evidence/
.omo/evidence/*-plan-35-agent-surface-arc.md

# Pi state (used by taskplane)
.pi/
