{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Software Delivery Protocol change proposal",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sdp-proposal/1"
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "$ref": "#/definitions/reason"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/change"
      }
    }
  },
  "required": ["schema", "base", "reason", "changes"],
  "additionalProperties": false,
  "definitions": {
    "specId": {
      "type": "string",
      "pattern": "^spec:[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)*(?![\\s\\S])"
    },
    "entryAddress": {
      "type": "string",
      "pattern": "^spec:[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)*#(?:design|ui|question|rule)\\.[a-z][A-Za-z0-9]*(?![\\s\\S])"
    },
    "scopeRef": {
      "type": "string",
      "pattern": "^spec:[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)*(?:#(?:design|ui|question|rule)\\.[a-z][A-Za-z0-9]*)?(?![\\s\\S])"
    },
    "reason": {
      "type": "string",
      "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]*(?![\\s\\S])",
      "minLength": 1
    },
    "relation": {
      "type": "object",
      "properties": {
        "action": {
          "enum": ["declare", "remove"]
        },
        "from": {
          "$ref": "#/definitions/specId"
        },
        "type": {
          "enum": ["refines", "dependsOn", "constrainedBy", "decidedBy", "verifies", "supersedes"]
        },
        "target": {
          "$ref": "#/definitions/specId"
        }
      },
      "required": ["action", "from", "type", "target"],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/scopeRef"
          }
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "replaces": {
          "$ref": "#/definitions/entryAddress"
        },
        "follows": {
          "$ref": "#/definitions/entryAddress"
        },
        "relation": {
          "$ref": "#/definitions/relation"
        },
        "reason": {
          "$ref": "#/definitions/reason"
        }
      },
      "required": ["scope", "request"],
      "additionalProperties": false,
      "not": {
        "required": ["replaces", "follows"]
      }
    }
  }
}
