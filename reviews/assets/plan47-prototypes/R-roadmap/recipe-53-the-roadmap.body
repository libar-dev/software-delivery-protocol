const accepts = ["pack", "decider"];
const unknownParams = Object.keys(params).filter((name) => !accepts.includes(name));
if (unknownParams.length > 0) return { unknownParams, accepts };
const decider = params.decider ?? "owner";
const diagnostics = [];
if (params.decider === null || typeof decider !== "string" || !/^[a-z][a-z0-9-]*$/u.test(decider)) diagnostics.push({ parameter: "decider", problem: "Expected a lowercase token." });
const compare = (a, b) => a < b ? -1 : a > b ? 1 : 0;
const packs = graph.nodes.filter((node) => node.nodeType === "Pack");
let selected = [];
if (params.pack !== undefined) {
  const pack = typeof params.pack === "string" ? packs.find((node) => node.id === params.pack) : undefined;
  if (pack === undefined) diagnostics.push({ parameter: "pack", problem: "Expected the id of a Pack in this graph." });
  else selected = [pack];
} else selected = packs.filter((node) => node.order === "priority").sort((a, b) => compare(a.id, b.id));
if (diagnostics.length > 0) return { diagnostics };

const rungs = ["idea", "scoped", "defined", "ready"];
const contexts = new Map(g.specs().map((spec) => [spec.id, g.specContext(spec.id)]));
const children = new Map();
for (const edge of graph.edges) {
  if (edge.type !== "refines" || edge.claim !== "declared" || !contexts.has(edge.from) || !contexts.has(edge.to)) continue;
  children.set(edge.to, [...(children.get(edge.to) ?? []), edge.from]);
}
const settledKinds = new Set(["example", "decision"]);
const laneOf = (spec) => spec.statedReadiness !== "ready" ? (spec.derivedReadiness === "ready" ? "to state" : "to design")
  : settledKinds.has(spec.specKind) ? "settled"
  : spec.deliveryFacts.includes("implemented") ? "built" : "to build";
const open = (lane) => lane === "to design" || lane === "to state" || lane === "to build";
const scopeOf = (id) => {
  const seen = new Set([id]);
  const queue = [id];
  for (let at = 0; at < queue.length; at += 1) for (const child of children.get(queue[at]) ?? []) if (!seen.has(child)) { seen.add(child); queue.push(child); }
  return [...seen].sort(compare);
};

const queue = await recipes(46, { decider });
const queuePlace = new Map((queue.statements ?? []).map((row) => [row.id, row.place]));
const roadmaps = selected.map((pack) => {
  const members = pack.members.filter((id) => contexts.has(id));
  const scopes = members.map((id) => new Set(scopeOf(id)));
  const placeOf = (id) => { const at = scopes.findIndex((scope) => scope.has(id)); return at === -1 ? null : at + 1; };
  const entries = [], apart = [];
  const questionRows = new Map(), statements = new Map();
  const touch = (map, key, row, place) => { const existing = map.get(key) ?? { ...row, places: [] }; if (!existing.places.includes(place)) existing.places.push(place); map.set(key, existing); };
  members.forEach((id, index) => {
    const place = index + 1;
    const spec = contexts.get(id);
    const scope = scopes[index];
    const scopeIds = [...scope];
    const work = scopeIds.filter((member) => !settledKinds.has(contexts.get(member).specKind));
    const lanes = work.map((member) => laneOf(contexts.get(member)));
    for (const member of scopeIds) {
      const context = contexts.get(member);
      for (const question of context.designColumns.openQuestions) if (question.decider === decider)
        touch(questionRows, `${member}\u0000${question.index}`, { address: question.key === undefined ? null : `${member}#question.${question.key}`, spec: member, index: question.index, question: question.question, blocking: question.blocking, provisional: question.provisional ?? null }, place);
      if (rungs.indexOf(context.derivedReadiness) > rungs.indexOf(context.statedReadiness))
        touch(statements, member, { id: member, statedReadiness: context.statedReadiness, floorReached: context.derivedReadiness }, place);
    }
    const decisionIds = new Set(scopeIds.filter((member) => contexts.get(member).specKind === "decision"));
    for (const member of scopeIds) for (const end of contexts.get(member).relationsOut) if (end.claim === "declared" && end.type === "decidedBy" && contexts.has(end.otherId)) decisionIds.add(end.otherId);
    const decisions = [...decisionIds].sort(compare).map((decision) => contexts.get(decision)).filter((decision) => decision.statedReadiness !== "ready")
      .map((decision) => ({ id: decision.id, title: decision.title ?? null, statedReadiness: decision.statedReadiness,
        blockingQuestions: decision.designColumns.openQuestions.filter((question) => question.blocking && question.key !== undefined).map((question) => `${decision.id}#question.${question.key}`) }));
    for (const decision of decisions) {
      if (scope.has(decision.id)) continue;
      const shaping = contexts.get(decision.id);
      if (rungs.indexOf(shaping.derivedReadiness) > rungs.indexOf(shaping.statedReadiness))
        touch(statements, decision.id, { id: decision.id, statedReadiness: shaping.statedReadiness, floorReached: shaping.derivedReadiness }, place);
      for (const question of contexts.get(decision.id).designColumns.openQuestions) if (question.decider === decider)
        touch(questionRows, `${decision.id}\u0000${question.index}`, { address: question.key === undefined ? null : `${decision.id}#question.${question.key}`, spec: decision.id, index: question.index, question: question.question, blocking: question.blocking, provisional: question.provisional ?? null }, place);
    }
    if (work.length === 0) { apart.push({ place, id, specKind: spec.specKind, statedReadiness: spec.statedReadiness, lane: laneOf(spec) }); return; }
    const lane = ["to design", "to state", "to build"].find((value) => lanes.includes(value)) ?? "built";
    const blockingQuestions = scopeIds.flatMap((member) => contexts.get(member).designColumns.openQuestions.filter((question) => question.blocking)
      .map((question) => ({ address: question.key === undefined ? null : `${member}#question.${question.key}`, spec: member, question: question.question, decider: question.decider ?? null, provisional: question.provisional ?? null })));
    const restsOn = new Map();
    for (const member of scopeIds) for (const end of contexts.get(member).relationsOut) {
      if (end.claim !== "declared" || scope.has(end.otherId) || !contexts.has(end.otherId)) continue;
      if (!(end.type === "dependsOn" || end.type === "constrainedBy" || (end.type === "refines" && member === id))) continue;
      const target = contexts.get(end.otherId);
      const targetLane = laneOf(target);
      if (!open(targetLane)) continue;
      restsOn.set(`${end.otherId}\u0000${end.type}`, { id: end.otherId, via: end.type, lane: targetLane, statedReadiness: target.statedReadiness, holdsReady: rungs.indexOf(target.statedReadiness) < rungs.indexOf("defined"), onRoadmap: placeOf(end.otherId) });
    }
    const restedOnBy = new Map();
    for (const member of scopeIds) for (const end of contexts.get(member).relationsIn) {
      if (end.claim !== "declared" || scope.has(end.otherId) || !contexts.has(end.otherId)) continue;
      if (!(end.type === "dependsOn" || end.type === "constrainedBy" || end.type === "decidedBy")) continue;
      const source = contexts.get(end.otherId);
      const sourceLane = laneOf(source);
      if (!open(sourceLane)) continue;
      restedOnBy.set(`${end.otherId}\u0000${end.type}`, { id: end.otherId, via: end.type, lane: sourceLane, onRoadmap: placeOf(end.otherId) });
    }
    const byIdThenVia = (a, b) => compare(a.id, b.id) || compare(a.via, b.via);
    entries.push({
      place, id, title: spec.title ?? null, specKind: spec.specKind, altitude: spec.altitude, lane,
      statedReadiness: spec.statedReadiness, floorReached: spec.derivedReadiness ?? null,
      statedNextRung: spec.statedNextRung ?? null, holdsNextRung: spec.statedNextRungFailures.map((failure) => failure.clauseId),
      work: { specs: work.length, toDesign: lanes.filter((value) => value === "to design").length, toState: lanes.filter((value) => value === "to state").length, toBuild: lanes.filter((value) => value === "to build").length,
        built: lanes.filter((value) => value === "built").length,
        drift: work.filter((member) => contexts.get(member).statedReadiness !== "ready" && contexts.get(member).deliveryFacts.includes("implemented")).length },
      buildNow: work.filter((member) => laneOf(contexts.get(member)) === "to build"),
      blockingQuestions, decisions,
      restsOn: [...restsOn.values()].sort(byIdThenVia), restedOnBy: [...restedOnBy.values()].sort(byIdThenVia),
      packs: [...spec.packs].filter((packId) => packId !== pack.id).sort(compare),
      sharesScopeWith: scopes.map((other, at) => at !== index && scopeIds.some((member) => other.has(member)) ? at + 1 : null).filter((value) => value !== null),
    });
  });
  const byPlace = (a, b) => a.places[0] - b.places[0];
  const waiting = {
    questions: [...questionRows.values()].sort((a, b) => byPlace(a, b) || Number(b.blocking) - Number(a.blocking) || compare(a.spec, b.spec) || a.index - b.index),
    statements: [...statements.values()].sort((a, b) => byPlace(a, b) || (queuePlace.get(a.id) ?? Infinity) - (queuePlace.get(b.id) ?? Infinity) || compare(a.id, b.id)),
  };
  return {
    pack: pack.id, title: pack.title ?? null, framing: pack.framing ?? null, order: pack.order === "priority" ? "priority" : "reading",
    totals: { entries: members.length, toDesign: entries.filter((row) => row.lane === "to design").length, toState: entries.filter((row) => row.lane === "to state").length, toBuild: entries.filter((row) => row.lane === "to build").length,
      built: entries.filter((row) => row.lane === "built").length, apart: apart.length,
      questions: waiting.questions.length, blockingQuestions: waiting.questions.filter((row) => row.blocking).length,
      statements: waiting.statements.length },
    entries, apart, waiting,
  };
});
return { decider, roadmaps };
