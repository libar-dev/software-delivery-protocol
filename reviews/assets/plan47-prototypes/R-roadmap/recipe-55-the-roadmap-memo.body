const accepts = ["pack", "decider"];
const unknownParams = Object.keys(params).filter((name) => !accepts.includes(name));
if (unknownParams.length > 0) return { unknownParams, accepts };
// The shipped body calls `recipes(53, ...)`; the prototype inlines the drafted body 53 here.
const roadmapOf = async (params) => { /*RECIPE53*/ };
let pack = params.pack;
if (pack === undefined) {
  const priority = graph.nodes.filter((node) => node.nodeType === "Pack" && node.order === "priority");
  if (priority.length !== 1) return { diagnostics: [{ parameter: "pack", problem: priority.length === 0 ? "No Pack states order: priority; name one." : "Several Packs state order: priority; name one." }], memo: null };
  pack = priority[0].id;
}
const answer = await roadmapOf({ pack, ...(params.decider === undefined ? {} : { decider: params.decider }) });
if (answer.diagnostics !== undefined) return { diagnostics: answer.diagnostics, memo: null };
const roadmap = answer.roadmaps[0];
const register = await recipes(20);

const span = (text) => {
  const value = String(text);
  const longest = Math.max(0, ...[...value.matchAll(/`+/gu)].map((match) => match[0].length));
  const ticks = "`".repeat(longest + 1);
  const pad = value.startsWith("`") || value.endsWith("`") ? " " : "";
  return `${ticks}${pad}${value}${pad}${ticks}`;
};
const cell = (text) => String(text).replace(/\r?\n/gu, " ").replace(/\|/gu, "\\|");
const lines = [];
const push = (...values) => lines.push(...values);
const contexts = new Map(roadmap.entries.map((entry) => [entry.id, g.specContext(entry.id)]));
const why = (entry) => {
  const intent = contexts.get(entry.id).sections?.intent ?? {};
  const line = (intent.problem ?? intent.outcome ?? "").trim();
  const own = line === "" || /[.!?]$/u.test(line) ? line : `${line}.`;
  const derived = [];
  if (entry.restedOnBy.length > 0) derived.push(`Waited on by ${entry.restedOnBy.length}.`);
  if (entry.buildNow.length > 0 && entry.lane !== "to build") derived.push(`${entry.buildNow.length} of its parts ready to build now.`);
  return [own, ...derived].filter((part) => part !== "").join(" ");
};
const entryCell = (entry) => `${cell(entry.title ?? entry.id)} ${span(entry.id)}`;

push("## The next work, from the roadmap", "");
push(`Roadmap: ${cell(roadmap.title ?? roadmap.pack)} ${span(roadmap.pack)}`, "");
for (const paragraph of (roadmap.framing ?? "").split(/\n\s*\n/u).map((part) => part.trim()).filter((part) => part !== "")) push(paragraph, "");
if (roadmap.order !== "priority") push("This Pack's order is reading order, not a stated priority.", "");

const lane = (name) => roadmap.entries.filter((entry) => entry.lane === name);
push("### To design", "");
if (lane("to design").length === 0) push("No entry needs design.", "");
else {
  push("| Place | Entry | Next | Why now |", "| --- | --- | --- | --- |");
  for (const entry of lane("to design")) {
    const next = [];
    if (entry.statedNextRung !== null) next.push(`${span(entry.statedReadiness)} → ${span(entry.statedNextRung)}${entry.holdsNextRung.length > 0 ? `, held by ${entry.holdsNextRung.join(", ")}` : ", nothing holds it"}`);
    if (entry.work.specs > 1) next.push(`${entry.work.toDesign} of ${entry.work.specs} parts to design`);
    const blocked = entry.blockingQuestions.map((question) => question.address === null ? span(question.spec) : span(question.address));
    if (blocked.length > 0) next.push(`blocked by ${blocked.join(", ")}`);
    if (entry.decisions.length > 0) next.push(`decided by ${entry.decisions.map((decision) => `${span(decision.id)} (${decision.statedReadiness})`).join(", ")}`);
    push(`| ${entry.place} | ${entryCell(entry)} | ${cell(next.join("; "))} | ${cell(why(entry))} |`);
  }
  push("");
}
if (lane("to state").length > 0) {
  push("### To state", "");
  push("| Place | Entry | Statements first | Why now |", "| --- | --- | --- | --- |");
  for (const entry of lane("to state")) {
    const first = entry.restsOn.filter((row) => row.lane === "to state");
    const firstText = first.length === 0 ? "none: its own statement can be made now" : `${first.length} Specs it rests on wait for a statement, ${first.filter((row) => row.onRoadmap === null).length} of them outside the roadmap`;
    push(`| ${entry.place} | ${entryCell(entry)} | ${cell(firstText)} | ${cell(why(entry))} |`);
  }
  push("");
}
push("### To build", "");
if (lane("to build").length === 0) push("No entry is ready to build.", "");
else {
  push("| Place | Entry | Why now | Rests on |", "| --- | --- | --- | --- |");
  for (const entry of lane("to build")) {
    const rests = entry.restsOn.map((row) => `${span(row.id)} (${row.lane})`);
    push(`| ${entry.place} | ${entryCell(entry)} | ${cell(why(entry))} | ${cell(rests.length === 0 ? "nothing unbuilt" : rests.join(", "))} |`);
  }
  push("");
}
const questions = roadmap.waiting.questions;
const statements = roadmap.waiting.statements;
if (questions.length + statements.length > 0) {
  push(`### Waiting on the ${answer.decider}`, "");
  for (const question of questions) push(`- ${question.address === null ? span(question.spec) : span(question.address)}${question.blocking ? " (blocking)" : ""}, place ${question.places.join(", ")}: ${cell(question.question)}`);
  for (const statement of statements) push(`- State ${span(statement.id)}: it states ${span(statement.statedReadiness)} and its floor allows ${span(statement.floorReached)}; place ${statement.places.join(", ")}`);
  push("");
}
const built = lane("built");
if (built.length > 0) {
  push("### Built and still on the roadmap", "");
  for (const entry of built) push(`- ${entry.place}. ${entryCell(entry)}`);
  push("");
}
const deferrals = register.specs.flatMap((spec) => spec.questions.filter((question) => question.deferral).map((question) => ({ spec: spec.id, question })));
if (deferrals.length > 0) {
  push("### Deferred, with their triggers", "");
  for (const { spec, question } of deferrals) push(`- ${question.key === undefined || question.key === null ? span(spec) : span(`${spec}#question.${question.key}`)}: ${cell(question.question)} Trigger: ${cell(question.trigger)}`);
  push("");
}
while (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
return { diagnostics: [], memo: `${lines.join("\n")}\n` };
