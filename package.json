{
  "name": "@libar-dev/software-delivery-protocol",
  "version": "0.0.0",
  "description": "Libar Software Delivery Protocol — a typed, executable, self-validating meta-model of the software-delivery process: author Specs as code, derive one graph, check conformance and honesty.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libar-dev/software-delivery-protocol.git"
  },
  "type": "module",
  "files": [
    "dist/**",
    "specs/**/*.sdp.md",
    "specs/**/*.sdp.gherkin",
    "CONTEXT.md",
    "docs/concept/DECISIONS.md",
    "docs/agent-surface/recipes.md",
    "docs/agent-surface/upgrade-guide.md",
    "schemas/sdp-proposal-1.schema.json",
    "docs/agent-surface/architecture.md",
    "plugin.json",
    "skills/**",
    "hooks/**",
    "kimi.plugin.json",
    ".zcode-plugin/**",
    "opencode/**"
  ],
  "bin": {
    "sdp": "./dist/cli/sdp.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./anchors": {
      "import": {
        "types": "./dist/anchors.d.ts",
        "default": "./dist/anchors.js"
      }
    },
    "./concept-match": {
      "import": {
        "types": "./dist/reader/concept-match.d.ts",
        "default": "./dist/reader/concept-match.js"
      }
    },
    "./runner": {
      "import": {
        "types": "./dist/runner/index.d.ts",
        "default": "./dist/runner/index.js"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/adapters/vitest.d.ts",
        "default": "./dist/adapters/vitest.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsup && tsup src/index.ts --no-config --format cjs --dts-only",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "node ./vitest-test.mjs",
    "check:git-install": "node ./check-git-install.mjs",
    "test:watch": "vitest",
    "sdp": "node ./dist/cli/sdp.js",
    "sdp:q": "node ./skills/sdp-agent-surface/scripts/q.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:temporal": "node ./check-temporal.mjs",
    "check:articles": "node docs/articles/sync-evidence.mjs --check",
    "generate:example": "node ./projection-suite.mjs examples/checkout-v1",
    "generate:self-hosting": "node ./projection-suite.mjs . --exclude explorations --exclude examples --exclude test/fixtures/import/parity",
    "check:self-hosting": "node ./projection-suite.mjs . --exclude explorations --exclude examples --exclude test/fixtures/import/parity --check-clean",
    "check:self-hosting-gates": "node ./check-self-hosting-gates.mjs",
    "check:example": "node ./projection-suite.mjs examples/checkout-v1 --check-clean",
    "preflight": "node ./preflight.mjs",
    "check": "npm run check:temporal && npm run lint && npm run format:check && npm run build && npm run generate:self-hosting && npm run generate:example && npm run typecheck && npm run typecheck:examples && npm test && npm run check:self-hosting-gates && npm run check:self-hosting && npm run check:example && npm run preflight"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@npmcli/arborist": "9.1.6",
    "@types/node": "^20.0.0",
    "ajv": "^6.15.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "mlly": "1.8.2",
    "npm-packlist": "10.0.2",
    "postcss": "8.5.24",
    "prettier": "^3.0.0",
    "tinyglobby": "^0.2.17",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "junk": "4.0.1",
    "ts-morph": "~28.0.0",
    "yaml": "2.9.0"
  }
}
